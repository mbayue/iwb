# Facebook Page API Credentials
# Dapatkan dari https://developers.facebook.com
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
FB_GRAPH_VERSION=v21.0

# Pengaturan Jadwal Otomatis (dalam detik)
# 3600 = 1 jam sekali, 1800 = 30 menit sekali
POST_INTERVAL_SECONDS=3600

# Pengaturan Simulasi
START_YEAR=2026
START_MONTH=1

# Tema Visual Peta: "light" (Atlas Geopolitik Modern) atau "dark" (Tactical Military Command)
MAP_THEME=light
ATTACKER_BASE_WIN_RATE=0.62
SIZE_BONUS_FACTOR=0.015
